      "name": "PayPal - Verify Webhook"
    },
    {
      "parameters": {
        "jsCode": "const verification = $input.first().json;\n\nif (verification.verification_status !== 'SUCCESS') {\n  throw new Error('PayPal webhook signature verification failed');\n}\n\nconst receivedBody = $('Webhook').first().json.body;\nconst event = typeof receivedBody === 'string'\n  ? JSON.parse(receivedBody)\n  : receivedBody;\n\nif (!event || !event.id || !event.event_type) {\n  throw new Error('PayPal webhook event is incomplete');\n}\n\nconst subscriptionTypes = new Set([\n  'PAYMENT.SALE.COMPLETED', 'PAYMENT.SALE.REFUNDED', 'PAYMENT.SALE.REVERSED',\n  'BILLING.SUBSCRIPTION.ACTIVATED', 'BILLING.SUBSCRIPTION.CANCELLED',\n  'BILLING.SUBSCRIPTION.SUSPENDED', 'BILLING.SUBSCRIPTION.EXPIRED',\n  'BILLING.SUBSCRIPTION.PAYMENT.FAILED'\n]);\nconst isSubscriptionEvent = subscriptionTypes.has(event.event_type);\nconst subscriptionId = event.event_type.startsWith('PAYMENT.SALE.')\n  ? event.resource?.billing_agreement_id : event.resource?.id;\nif (isSubscriptionEvent && !/^I-[A-Z0-9]+$/.test(subscriptionId || '')) {\n  throw new Error('Verified subscription event has no subscription ID');\n}\n\nreturn [{\n  json: {\n    provider: 'paypal',\n    environment: 'sandbox',\n    provider_event_id: event.id,\n    event_type: event.event_type,\n    is_subscription_event: isSubscriptionEvent,\n    subscription_id: isSubscriptionEvent ? subscriptionId : null,\n    event\n  }\n}];"
      },

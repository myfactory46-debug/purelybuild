        "jsonBody": "={{ JSON.stringify({\n  transmission_id: $('Webhook').first().json.headers['paypal-transmission-id'],\n  transmission_time: $('Webhook').first().json.headers['paypal-transmission-time'],\n  cert_url: $('Webhook').first().json.headers['paypal-cert-url'],\n  auth_algo: $('Webhook').first().json.headers['paypal-auth-algo'],\n  transmission_sig: $('Webhook').first().json.headers['paypal-transmission-sig'],\n  webhook_id: '0Y7460589Y661605U',\n  webhook_event: typeof $('Webhook').first().json.body === 'string'\n    ? JSON.parse($('Webhook').first().json.body)\n    : $('Webhook').first().json.body\n}) }}\n",
